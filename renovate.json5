{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // 共有ポリシー: https://github.com/seijikohara/renovate-config
  extends: ["github>seijikohara/renovate-config:default.json5"],
  packageRules: [
    {
      description: "Group the textlint toolchain",
      groupName: "textlint",
      matchPackageNames: ["textlint", "textlint-*"],
    },
  ],
}
